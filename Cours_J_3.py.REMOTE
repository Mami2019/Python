"""
Boucle while et for
"""
# while : boucle conditionnelle
n = 1
while n <= 5:
    print(n)
    n += 1

# for : boucle sur une séquence
for i in range(3):
    print("Bonjour", i)


# break / continue
for i in range(10):
    if i == 5:
        break    # stoppe la boucle
    if i % 2 == 0:
        continue  # soute le reste et passe au suivant
    print(i)