"""
Objectifs du jour
Répéter des instructions avec "while"
Parcourir des séquences avec "for"
Comprendre "range(start, stop, step)"
Utiliser break et continue
"""
#while: boucle conditionnelle
n = 1
while n <= 5:
    print(n)
    n += 1

# for: boucle sur une séquence
for i in range(3):
    print("Bonjour", i)


for i in range(10):
    if i == 5:
        break  # stoppe la boucle
    if i % 2 ==0
        continue #
    print(i)
